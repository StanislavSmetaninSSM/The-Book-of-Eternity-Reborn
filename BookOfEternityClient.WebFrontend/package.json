{
  "name": "book-of-eternity-reborn-webfrontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "node scripts/dev-local.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:player-facing": "node scripts/retired-test-entrypoint.mjs",
    "build": "npm run typecheck && vite build",
    "build:map-viewer": "node scripts/build-map-viewer.mjs",
    "verify": "node scripts/retired-test-entrypoint.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:categories": "pwsh -NoProfile -File ../scripts/test-csharp.ps1"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^0.460.0",
    "framer-motion": "^11.11.0"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "^4.1.7",
    "@fontsource/cinzel": "^5.1.0",
    "@fontsource/cinzel-decorative": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0"
  }
}
