{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "../TestResults/browser-frontend-player-facing-tests"
  },
  "include": [
    "src/api/contracts.ts",
    "src/qte/*.ts",
    "src/context/ShellContext.tsx",
    "src/hooks/useShellState.ts",
