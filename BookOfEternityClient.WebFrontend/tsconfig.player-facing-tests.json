    "src/components/*.tsx",
    "src/components/qte/*.tsx",
    "src/playerFacingCommandResult.ts",
    "test/playerFacingCommandResult.test.ts",
    "test/appRouteExtraction.test.ts",
    "test/useShellStateSettled.test.ts",
    "test/unifiedInputSubmitRace.test.ts",
    "test/connectionBanner.test.ts",
    "test/gracefulDegradation.test.ts",
    "test/gameLauncherMenuLayout.test.ts",
    "test/audioPanelCatalogVisibility.test.ts",
    "test/playerCopyRobustness.test.ts",
    "test/qteMiniGameHelpers.test.ts",
    "test/qteScenePanelMiniGames.test.tsx"
  ]
}
