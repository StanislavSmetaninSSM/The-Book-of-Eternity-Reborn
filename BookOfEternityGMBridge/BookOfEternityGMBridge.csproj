<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Permit cross-building the existing Windows consumer; this does not enable native hosting. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BookOfEternityGMBridge</AssemblyName>
    <RootNamespace>BookOfEternityGMBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookOfEternityClient\BookOfEternityClient.csproj" />
  </ItemGroup>

</Project>
