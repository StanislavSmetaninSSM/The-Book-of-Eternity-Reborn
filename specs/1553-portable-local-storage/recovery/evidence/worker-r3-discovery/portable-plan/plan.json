      "contracts": [
        "#1553 T041-WORKER-RESTART-R2",
        "FR-012/014/015"
      ]
    },
    {
      "category": "worker-execution-scoped-evidence",
      "reason": "CurrentUncertainty, ObserveStop and original cleanup authority gates changed on shared execution authority.",
      "contracts": [
        "#1553 T041-WORKER-RESTART-R2",
        "FR-012/014/015"
      ]
    },
    {
      "category": "worker-consumer-execution-evidence",
      "reason": "Both actual acceptance consumers must still require the original live publication permit.",
      "contracts": [
        "#1553 T041-WORKER-RESTART-R2",
        "FR-012/014/015"
      ]
    },
    {
      "category": "portable-session-generation",
      "reason": "The nonrecursive generation snapshot parser now sits below the worker lease predicate.",
      "contracts": [
        "#1553 T041-WORKER-RESTART-R2",
        "FR-012/014/015"
      ]
    },
    {
      "category": "portable-load-lease-consumers",
      "reason": "Default unbound recovery, generation and replacement admission must retain behavior with optional worker fences.",
      "contracts": [
        "#1553 T041-WORKER-RESTART-R2",
        "FR-012/014/015"
      ]
    },
    {
      "category": "portable-coordinated-lease-consumers",
      "reason": "Shared canonical validation still rejects disposed/foreign owners and preserves original operation lock ordering.",
      "contracts": [
        "#1553 T041-WORKER-RESTART-R2",
        "FR-012/014/015"
      ]
    },
    {
      "category": "worker-restart-default-controls",
