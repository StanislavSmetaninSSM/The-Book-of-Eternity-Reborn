  "checkerSource": "from pathlib import Path\nimport datetime, hashlib, json, os, subprocess, sys\n\nrepo = Path('/workspace/The-Book-of-Eternity-Reborn')\nhead, review_manifest = sys.argv[1:]\nsha = lambda b: hashlib.sha256(b).hexdigest()\ngit = lambda *a: subprocess.check_output(['git', *a], cwd=repo)\nassert git('rev-parse', 'HEAD').decode().strip() == head\nassert not git('status', '--porcelain')\nremote = dict(line.split()[::-1] for line in git('ls-remote', 'origin', 'refs/heads/1536-wound-b2-cloud-20261012', 'refs/heads/main').decode().splitlines())\nassert remote['refs/heads/1536-wound-b2-cloud-20261012'] == head\nassert remote['refs/heads/main'] == 'd0241e71e349fbe2020e4a41b6be7c627c81cbb4'\ncompiled = '0f00ee256797a4e21b6f314a2a0053ec6084f972'\nchanged = git('diff', '--name-only', compiled, head).decode().splitlines()\nassert changed and all(p.startswith('specs/1536-complete-wound-materialization/') for p in changed)\nrecovery = Path('/tmp/t179pd3d-root-recovery-composition-' + head[:8] + '-20261017.json')\ncomposition = json.loads(recovery.read_text())\nassert composition['head'] == head\npacket_path = repo / 'specs/1536-complete-wound-materialization/recovery/t179pd3d-ordinary-tests-source-packet-20261017.json'\npacket = json.loads(packet_path.read_text())\nassert len(packet['sourcePins']) == 67 and len(packet['productDelta']) == 2\nfor pin in packet['sourcePins']:\n    b = (repo / pin['path']).read_bytes()\n    assert len(b) == pin['bytes'] and sha(b) == pin['sha256']\n    blob = hashlib.sha1(b'blob ' + str(len(b)).encode() + b'\\0' + b).hexdigest()\n    assert blob == pin['gitBlob']\nassert sha(json.dumps(packet['sourcePins'], ensure_ascii=False, separators=(',', ':')).encode()) == packet['sourcePinDigest']\nassert sha((repo / packet['currentLedger']['path']).read_bytes()) == packet['currentLedger']['sha256']\ncurrent = packet['counts']['currentActuals']\nassert current['ordinary52']['passed'] == current['ordinary52']['executed'] == 52\nassert current['ordinary52']['failed'] == 0 and current['ordinary52']['methods'] == 29\nassert current['separateProtectedLate2']['passed'] == current['separateProtectedLate2']['executed'] == 2\nassert current['separateProtectedLate2']['failed'] == 0 and current['boundedDistinctCases'] == 54\nassert packet['counts']['historicalTestsOnlyActuals']['failed'] == 2\nassert packet['futureProductionQualification']['ordinarySelection'].startswith('COMPLETE_BOUNDED')\nassert packet['futureProductionQualification']['protectedLate2'].startswith('COMPLETE_SEPARATE')\nassert packet['futureChecks']['remaining'].startswith('No bounded runtime/source work remains.')\nmanifest = json.loads(Path(review_manifest).read_text())\naccepted = []\nfor pin in manifest['acceptedExactArtifacts']:\n    p = repo / pin['path']\n    assert sha(p.read_bytes()) == pin['sha256']\n    accepted.append(dict(path=pin['path'], sha256=pin['sha256'], bytes=p.stat().st_size))\nrecord_path = Path('/tmp/t179pd3d-implementation-tools/t179pd3d-product-ordinary52-first-31fe14fa-20261017/record.json')\nrecord = json.loads(record_path.read_text())\nassert record['nativeExit'] == 0 and len(record['binaryAfter']) == 9\nassert sha(Path('/tmp/t179pd3d-root-first-ordinary52-inspection-31fe14fa-20261017.json').read_bytes()) == '3b18d23f08853838c3d34faf20a051cc90982520c3211b1806af16ea87209ccc'\nfor pin in record['binaryAfter']:\n    b = (repo / pin['path']).read_bytes()\n    assert len(b) == pin['bytes'] and sha(b) == pin['sha256']\nout = dict(kind='ROOT_FINAL_BOUNDED_PD3D_CHECKPOINT_EXACT_REMOTE_RECOVERY_AND_CURRENT_PINS', head=head, remote=remote,\n           compiledSource=compiled, onlySpecMetadataSinceCompiled=changed,\n           sourcePinsExact=67, nineFreshManagedBinaryCopiesUnchanged=True,\n           acceptedExactArtifacts=accepted, packetStatus=packet['status'], packetCounts=packet['counts'],\n           recovery=dict(path=str(recovery), sha256=sha(recovery.read_bytes()), completeConsecutiveDeltas=len(composition['completeConsecutiveDeltas']), trackedPaths=composition['trackedPaths']),\n           retainedRootOrdinaryInspection=dict(path='/tmp/t179pd3d-root-first-ordinary52-inspection-31fe14fa-20261017.json', sha256='3b18d23f08853838c3d34faf20a051cc90982520c3211b1806af16ea87209ccc'),\n           scope='Only current bounded ordinary kernels/actual consumers: ordinary52 and separately qualified protectedLate2. Initial NI-PREFLIGHT/NI-S01/causal RED preserved. No runtime rerun after accepted first outcomes. HOT/history/fullF1/M3/T197/oldWorld/platformWindows/A3 remain held. No main/merge/force/delete/credentials/security changes.',\n           checkerSource=Path(__file__).read_text(), utc=datetime.datetime.now(datetime.timezone.utc).isoformat())\ndest = Path('/tmp/t179pd3d-root-final-checkpoint-' + head[:8] + '-20261017.json')\nassert not dest.exists()\ndest.write_text(json.dumps(out, indent=2) + '\\n')\nprint(dest, sha(dest.read_bytes()))\n",
