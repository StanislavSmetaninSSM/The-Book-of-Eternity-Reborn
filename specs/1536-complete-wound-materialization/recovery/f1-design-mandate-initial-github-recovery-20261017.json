  "helper_text": "import concurrent.futures, datetime, hashlib, json, pathlib, subprocess, sys, urllib.request\nrepo=pathlib.Path('/workspace/The-Book-of-Eternity-Reborn')\nsha=sys.argv[1]; dest=pathlib.Path(sys.argv[2]); receipt=pathlib.Path(sys.argv[3])\nassert not dest.exists() and not receipt.exists()\nbase='c4dde0629cc17aad75196ec509d2cdaf621945a3'\nbranch='1536-wound-b2-cloud-20261012'\ndef git(*args): return subprocess.check_output(['git','-C',str(repo),*args])\nassert git('rev-parse','HEAD').decode().strip()==sha\nassert not git('status','--porcelain')\nremote=git('ls-remote','origin','refs/heads/'+branch,'refs/heads/main').decode()\nassert sha+'\\trefs/heads/'+branch in remote\nassert 'd0241e71e349fbe2020e4a41b6be7c627c81cbb4\\trefs/heads/main' in remote\nprefix='specs/1536-complete-wound-materialization/'\npaths=['AGENTS.md','docs/development-workflow.md','.specify/memory/constitution.md','docs/testing.md',\n       prefix+'spec.md',prefix+'plan.md',prefix+'tasks.md',prefix+'contracts/mortal-wound-treatment.md',\n       prefix+'design/lawful-active-joint-tail-b.md',prefix+'design/lawful-active-joint-tail-b-implementation-plan.md',\n       prefix+'design/lawful-active-joint-tail-b-ordinary-outcomes.md',prefix+'design/lawful-active-joint-tail-b-death-handoff.md']\nfor p in git('ls-tree','-r','--name-only',sha,'--',prefix+'recovery').decode().splitlines():\n    name=pathlib.PurePosixPath(p).name\n    if name.startswith(('lawful-active-f1-independent-design-','lawful-active-f1-r2-independent-design-','lawful-active-f1-final-design-corrected-','lawful-active-b-corrected-independent-plan-')) and name.endswith(('.md','.json')):\n        paths.append(p)\n# Current block changes are included when re-used after publication.\npaths+=git('diff','--name-only','0734df4c63d7f6ecd0f9efee73d0314fee822850',sha,'--',prefix).decode().splitlines()\npaths=sorted(set(paths)); dest.mkdir()\nstarted=datetime.datetime.now(datetime.timezone.utc).isoformat()\njobs=[]; missing=[]\nfor revision in [base,sha]:\n    for path in paths:\n        q=subprocess.run(['git','-C',str(repo),'rev-parse','--verify',revision+':'+path],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)\n        if q.returncode: missing.append({'revision':revision,'path':path,'disposition':'absent_at_revision'}); continue\n        jobs.append((revision,path,q.stdout.decode().strip()))\ndef fetch(job):\n    rev,path,blob=job\n    url='https://raw.githubusercontent.com/StanislavSmetaninSSM/The-Book-of-Eternity-Reborn/'+rev+'/'+path\n    data=urllib.request.urlopen(urllib.request.Request(url,headers={'User-Agent':'Codex-F1-document-recovery'}),timeout=60).read()\n    assert data==git('show',rev+':'+path),path\n    actual=hashlib.sha1(b'blob '+str(len(data)).encode()+b'\\0'+data).hexdigest()\n    assert actual==blob,path\n    target=dest/rev/path; target.parent.mkdir(parents=True,exist_ok=True); target.write_bytes(data)\n    return {'revision':rev,'path':path,'bytes':len(data),'git_blob':blob,'sha256':hashlib.sha256(data).hexdigest(),'url':url}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool: rows=list(pool.map(fetch,jobs))\nassert git('rev-parse','HEAD').decode().strip()==sha and not git('status','--porcelain')\nresult={'kind':'selected_document_recovery_not_full_checkout_not_runtime','requested_checkpoint':base,'current_branch_sha':sha,'branch':branch,'directory':str(dest),'remote_readback':remote,'started_utc':started,'completed_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'files':rows,'absent_at_revision':missing,'file_count':len(rows),'helper_text':pathlib.Path(__file__).read_text()}\nreceipt.write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\\n')\nprint(json.dumps({'sha':sha,'files':len(rows),'absent':len(missing),'receipt':str(receipt),'receipt_sha256':hashlib.sha256(receipt.read_bytes()).hexdigest()}))\n"
