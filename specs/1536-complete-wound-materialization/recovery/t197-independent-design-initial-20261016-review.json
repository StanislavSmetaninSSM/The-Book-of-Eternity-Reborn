  "findings": [
    {
      "id": "T197-R1",
      "priority": "P1",
      "kind": "confirmed_design_omission",
      "title": "Assign target progression preparation to a real atomic cohort",
      "design_lines": [
        62,
        68,
        73,
        79,
        88,
        105
      ],
      "source_citations": [
        "BookOfEternityClient/Core/GameEngine/GameEngine.TurnLifecycle.cs:2732-2734",
        "BookOfEternityClient/Services/ProgressionScheduleService.cs:132-195,207-257,1314-1370,1401-1403"
      ],
      "scenario": "A valid death prepares the Chaos Sea request, then crashes or retries before target installation. The real preparation writes progression_schedule.json, but H0 is M-only and H1/H2 never own this member. Calling the real helper leaks an unacknowledged write; only freezing the returned control omits the real schedule transition.",
      "required_fix": "Pure-extract actual preparation, with initialized/missing/malformed cases, exact source schedule/world-time/soul/Shining inputs, UTC and pending-cycle after-image. Assign progression_schedule.json to one named H phase and target-original/repair roles; define later E progression separately.",
      "future_oracle": "H09 plus schedule preparation cuts: no precommit changes, exact schedule+ack commit, frozen request/control agreement, no extra ordinal or pending-cycle advance on retry, cold recovery with empty caches."
    },
    {
      "id": "T197-R2",
      "priority": "P1",
      "kind": "confirmed_design_incompleteness",
      "title": "Specify the browser successor state and original/main closure",
      "design_lines": [
        84,
        92,
        179
      ],
      "source_citations": [
        "BookOfEternityClient/Services/PendingPlayerActionService.cs:23-54,73-105",
        "BookOfEternityClient/Core/GameEngine/GameEngine.BrowserPlayerInput.cs:126-174,265-292,408-440",
        "BookOfEternityClient/Core/GameEngine/GameEngine.TurnLifecycle.cs:1094-1103,1920-1926"
      ],
      "scenario": "H2 installs target headers/request while source pending browser action survives. Current terminalProcessing is unrecoverable; staged requires the old current tuple; accepted requires current request/headers to be absent. The proposal names a handoff/terminal state but chooses no schema/disposition or cold classification.",
      "required_fix": "Name exact source binding, pending phase/disposition, receipt fields and artifact inventory, original/main completion or transfer proof, durable close-debt representation and release/dequeue cut. Specify normal/late/reload readers and target-blocked input without synthesizing a new browser action.",
      "future_oracle": "H16 with actual parser/classifier, H2/H3 faults and fresh PID, successful and failed original/main close, target installed, source released and terminal dequeue."
    },
    {
      "id": "T197-R3",
      "priority": "P1",
      "kind": "confirmed_unresolved_design_dependency",
      "title": "Resolve target remaining-work acceptance without claiming a complete destination owner",
      "design_lines": [
        45,
        104,
        109,
        113,
        115,
        145
      ],
      "source_citations": [
        "specs/1536-complete-wound-materialization/design/lawful-active-joint-tail-b-ordinary-outcomes.md:357-389",
        "specs/1536-complete-wound-materialization/design/lawful-active-joint-tail-b-implementation-plan.md:477-487",
        "BookOfEternityClient/Core/GameEngine/GameEngine.TurnLifecycle.cs:2747-2809",
        "BookOfEternityClient/Core/GameEngine/GameEngine.ValidationAndRepair.cs:418-486,542-573",
        "BookOfEternityClient/Services/CanonicalStateNormalizer.cs:406-480"
      ],
      "scenario": "After H3 deletes source originals, a lawful evaluation reaches a partially published target response or an eligible incarnation trigger. E1 and the successor issuer remain unnamed implementation alternatives without finite contribution/debt contracts. Retained originals and a Boolean accepted disposition do not prove who can finish or recover each outstanding mutation.",
      "required_fix": "Select a bounded actual-owner integration and specify source-to-target ownership at H2, reachable target contribution/repair/publication receipts, cold debt continuation and exact target cleanup. Separately identify any eligible successor acceptance dependency. It may stay an explicit release blocker in staged work, but cannot be accepted as a resolved exact design or replaced with sequential handlers. Do not require unrelated afterlife/realm redesign.",
      "future_oracle": "H10-H15 must be instantiated against actual target owners and lawful mixed response contributions, known rollback/uncertainty/committed lost reply, failed/successful successor transfer and no reward replay."
    },
    {
      "id": "T197-R4",
      "priority": "P2",
      "kind": "confirmed_schema_gap",
      "title": "Give E2 and E3 distinct immutable acknowledgement slots or one specified atomic cut",
      "design_lines": [
        38,
        102,
        104,
        105,
        106,
        109
      ],
      "source_citations": [
        "specs/1536-complete-wound-materialization/design/lawful-active-joint-tail-b-death-handoff.md:38,102-109,128-130"
      ],
      "scenario": "E1 occupies evaluationAccepted. E2 publishes story/turn plus an ack, then E3 separately publishes archive/guard plus an ack. The closed schema only names evaluationFinalized before targetReleased and says every slot is empty or one immutable result. It does not encode the E2-complete/E3-due crash state without mutating that result or adding an undeclared slot.",
      "required_fix": "Specify finite immutable evaluationStory/progression and evaluationProjection/guard receipts, or explicitly compose E2/E3 into one exact cohort and revise fault/retry semantics. Define the full state transition table, including optional nextIncarnation and terminal status after original deletion.",
      "future_oracle": "Crash after E2 before E3, after each E3 member and lost acknowledgement; exact resumed phase and once-only story/runtime/guard/archive without mutable acceptance flags."
    },
    {
      "id": "T197-R5",
      "priority": "P2",
      "kind": "confirmed_authorization_scope_misclassification",
      "title": "Do not relabel the already authorized D11 handoff specialization as a new principled grant",
      "design_lines": [
        140,
        144,
        145,
        176,
        180
      ],
      "source_citations": [
        "specs/1536-complete-wound-materialization/design/lawful-active-joint-tail-b-ordinary-outcomes.md:352-389",
        "specs/1536-complete-wound-materialization/design/lawful-active-joint-tail-b-implementation-plan.md:479-486"
      ],
      "scenario": "The proposal calls H-TARGET a new principled boundary extension and groups E1-E4/successor work into H-DESTINATION. R2 already expressly requires actual target acceptance, exact input/recovery/cleanup and T197 realm/marker/control/data cohorts; the current user authorized staged D9-D11 implementation after independent design acceptance. Missing APIs are implementation/design dependencies, not automatically missing user permission.",
      "required_fix": "Classify H-TARGET and narrow existing-owner adapters as D11 specializations subject to corrected independent design acceptance. Decompose H-DESTINATION: necessary target debt/finalization proof; optional actual successor receipt; any truly new gameplay/source/realm/writer authority. Send only the last category with a concrete authority delta to the coordinator. No demonstrated blanket new grant is established by this document.",
      "future_oracle": "Review corrected authority table against exact issuer and eligible source boundaries; no new runtime check was performed."
    }
  ],
  "optional_risks": [
    "Clarify H2 versus H3 dispatch barrier and H3 current-image guards with active daemon scanning.",
    "Provide concrete copy-role mapping and inert terminal status example after original deletion.",
    "Correct resource source table wording: five owner roots total, not other five."
  ],
  "authority_assessment": {
    "H_TARGET": "D11 specialization already required by R2; corrected independent design acceptance remains required, not fresh user permission per path",
    "H_DESTINATION": "Decompose existing-owner continuation/finalization and specific eligible successor dependencies; blanket new grant not established",
    "new_principled_grants_confirmed": [],
    "coordinator_required_only_for": "A concrete new source/realm/gameplay/writer authority beyond accepted R2, if one is actually identified"
  },
