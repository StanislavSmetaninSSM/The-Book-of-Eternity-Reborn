xit = $native; ResultDirectories = @($new.FullName) }\n            $record | ConvertTo-Json -Depth 12 | Set-Content \"$evidence/$Label.native.json\" -Encoding utf8NoBOM\n            Require ($new.Count -eq 1) \"Expected exactly one new result directory for $Label.\"\n            return [pscustomobject]@{ NativeExit = $native; Directory = $new[0].FullName }\n          }\n          Require ([OperatingSystem]::IsWindows()) 'Positive ordinary worker qualification requires native WindowsJob.'\n          Require ($env:GITHUB_EVENT_NAME -ceq 'push' -and $env:GITHUB_REF -ceq 'refs/heads/1536-wound-b2-cloud-20261012') 'Wrong release event or branch.'\n          Require ($env:GITHUB_RUN_ATTEMPT -ceq '1') 'No workflow/job retry is released.'\n          $head = GitValue @('rev-parse', 'HEAD')\n          Require ($head -ceq $env:GITHUB_SHA) 'Checkout differs from event SHA.'\n          Require (@(GitValue @('status', '--porcelain')).Count -eq 0) 'Checkout is not clean.'\n          $release = Get-Content -LiteralPath $releasePath -Raw | ConvertFrom-Json -AsHashtable\n          Require ($release.schemaVersion -eq 1 -and $release.decision -ceq 'ACCEPTED_SOURCE_FIRST_WINDOWS_WORKER2') 'No exact first-worker release.'\n          Require ($release.reviewedSource -cmatch '^[0-9a-f]{40}$' -and $release.acceptedCheckpoint -cmatch '^[0-9a-f]{40}$') 'Release source pins are invalid.'\n          Require ((GitValue @('rev-parse', 'HEAD^')) -ceq $release.acceptedCheckpoint) 'Release is not directly after the saved SOURCE acceptance.'\n          Require (@(GitValue @('ls-tree', '-r', '--name-only', $release.acceptedCheckpoint, '--', $releasePath)).Count -eq 0) 'Release file must be a first addition.'\n          $releaseDiff = @(GitValue @('diff', '--name-status', $release.acceptedCheckpoint, 'HEAD'))\n          Require ($releaseDiff.Count -eq 1 -and $releaseDiff[0] -ceq \"A`t$releasePath\") 'Release commit must add only the dedicated release file.'\n          # Explicit bounded pinned history;