son\n          $planSummary = Get-Content (Join-Path $planRun.Directory 'summary.json') -Raw | ConvertFrom-Json\n          Require ($planSummary.PlanOnly -and $planSummary.Tests.Executed -eq 0 -and @($plan.Descriptors).Count -eq 1) 'PlanOnly must execute zero tests and plan one descriptor.'\n          $descriptor = $plan.Descriptors[0]\n          Require ($descriptor.Category -ceq $category -and $descriptor.Adapter -ceq 'integration' -and $descriptor.Exclusive -and -not $descriptor.FrontendBuild -and $descriptor.BudgetMinutes -eq 5 -and $descriptor.EstimatedCases -eq 2 -and @($descriptor.ExpectedMethodCounts).Count -eq 1 -and $descriptor.ExpectedMethodCounts[0].Name -ceq 'BookOfEternityClient.Tests.GameEngineTurnLifecycleTests.HotSubmission_ActualWorkerApplyCannotIssueOrdinaryReadyCustody' -and $descriptor.ExpectedMethodCounts[0].Cases -eq 2) 'Exact worker method/count/budget differs.'\n          $beforeDll = @(DllPins)\n          $beforeTemp = @(OwnedPrefix)\n          Require ($beforeTemp.Count -eq 0) 'Scoped fixture residue exists before actual.'\n          Require (@(GitValue @('status', '--porcelain')).Count -eq 0) 'Source changed during preparation.'\n          $beforeDll | ConvertTo-Json -Depth 8 | Set-Content \"$evidence/dll-before.json\" -Encoding utf8NoBOM\n          $beforeTemp | ConvertTo-Json -AsArray | Set-Content \"$evidence/temp-before.json\" -Encoding utf8NoBOM\n          $actualFailure = $null\n          try { $actualRun = InvokeBounded 'first-worker2' @('-SelectionFile', $releasePath, '-NoBuild') }\n          catch { $actualFailure = $_ }\n          finally {\n            $afterDll = @(DllPins)\n            $afterTemp = @(OwnedPrefix)\n            $afterStatus = @(GitValue @('status', '--porcelain'))\n            $afterHead = GitValue @('rev-parse', 'HEAD')\n            [ordered]@{ Source = $afterHead; Status = $afterStatus; Dll = $afterDll; ScopedTemp = $afterTemp; WrapperFailure = if ($actualFailure) { $actualFailure.ToString() } else { $null } 