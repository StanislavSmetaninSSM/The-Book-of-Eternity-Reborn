m -ItemType Directory -Path TestResults -Force | Out-Null\n          $selection | ConvertTo-Json -Depth 20 | Set-Content TestResults/ci-selection.json -Encoding utf8NoBOM\n\n      - name: Verify preinstalled frontend Node\n        if: matrix.frontend\n        shell: pwsh\n        run: |\n          $ErrorActionPreference = 'Stop'\n          $nodeVersion = & node --version\n          if ($LASTEXITCODE -ne 0 -or $nodeVersion -isnot [string] -or\n              $nodeVersion -notmatch '^v22\\.(\\d+)\\.\\d+$' -or [int]$Matches[1] -lt 12) {\n            throw 'Frontend CI requires preinstalled Node.js 22.12+ (major 22); no installer or fallback is used.'\n          }\n          Write-Host \"Using runner Node.js $nodeVersion\"\n\n      - name: Restore browser frontend dependencies\n        if: matrix.frontend\n        run: npm ci --prefix BookOfEternityClient.WebFrontend\n\n      - name: Setup current compiler and target runtime\n        uses: actions/setup-dotnet@v4\n        with:\n          dotnet-version: |\n            8.0.x\n            10.0.x\n\n      - name: Verify explicitly selected contracts\n        shell: pwsh\n        run: |\n          ./scripts/test-csharp.ps1 -SelectionFile TestResults/ci-selection.json\n"
