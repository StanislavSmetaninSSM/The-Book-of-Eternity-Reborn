+name,mdhash,jsonhash=sys.argv[1:];r=Path('/workspace/The-Book-of-Eternity-Reborn');d=r/'specs/1536-complete-wound-materialization/recovery';h=lambda b:hashlib.sha256(b).hexdigest()
