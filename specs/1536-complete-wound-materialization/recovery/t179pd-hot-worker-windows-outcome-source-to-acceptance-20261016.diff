++      "text": "  \"id\": \"fr063-hot-worker-ready-disposition\",\n  \"responsibility\": \"#1536 T179-Pd.3b HS-IMPL-F03: Two genuine ordinary Stage→actual Wait/engine-dispatched process worker→real apply cases. Worker proposal uses actual task context/hash. Real worker-generated Ready is consumed but HOT stays unavailable; one-shot Ready publication IO fault armed by correlated durable proposal-applied event exercises actual accepted-apply/no-Ready direct return. Audit/task/trajectory/current bytes/G/strict cleanup must prove route, no dispatch field seeding.\",\n  \"excludes\": \"No component-only delegator/private accepted flag/fake original proof; ordinary worker behavior retained. This is unsupported HOT worker disposition only, not worker semantic source admission/native uncertainty/fullF1/S/B/M3.\",\n  \"changeHints\": [\n    \"BookOfEternityClient.IntegrationTests/GameEngineTurnLifecycleTests.HotWorkerDisposition.cs\"\n  ],\n  \"related\": [\n    {\n      \"id\": \"fr063-joint-late-completion\",\n      \"when\": \"FIRST protected Late2 after fresh BOTH/catalog/PlanOnly and independent SOURCE; separate frozen EVIDENCE before specifically released new GREEN singleton. No aggregate.\"\n    }\n  ],\n  \"requirements\": {\n    \"frontendBuild\": false,\n    \"exclusive\": true,\n    \"ciRunner\": \"ubuntu-24.04\"\n  },\n  \"timeoutMinutes\": 5,\n  \"expectedSeconds\": null,\n  \"selectors\": [\n    {\n      \"project\": \"integration\",\n      \"tests\": [\n        \"BookOfEternityClient.Tests.GameEngineTurnLifecycleTests.HotSubmission_ActualWorkerApplyCannotIssueOrdinaryReadyCustody\"\n      ]\n    }\n  ]\n},\n"
