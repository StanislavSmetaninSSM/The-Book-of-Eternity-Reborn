++      "text": "name: FR063 bounded ordinary worker Windows qualification\n\n# Source/preparation pushes do not execute this job. Add the release file once,\n# only after the independent affected SOURCE decision is saved and recovered.\non:\n  push:\n    branches: [1536-wound-b2-cloud-20261012]\n    paths: [tests/selections/1536-hot-worker-windows.json]\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: fr063-hot-worker-windows-${{ github.ref }}\n  cancel-in-progress: false\n\njobs:\n  first-worker2:\n    runs-on: windows-latest\n    timeout-minutes: 25\n    env:\n      DOTNET_CLI_TELEMETRY_OPTOUT: '1'\n      POWERSHELL_TELEMETRY_OPTOUT: '1'\n      TESTINGPLATFORM_TELEMETRY_OPTOUT: '1'\n      DOTNET_SKIP_FIRST_TIME_EXPERIENCE: '1'\n      DOTNET_GENERATE_ASPNET_CERTIFICATE: 'false'\n      DOTNET_PROCESSOR_COUNT: '1'\n      GenerateDocumentationFile: 'true'\n      NoWarn: '1591'\n      # Apply before checkout materializes files; hashes below are raw bytes.\n      GIT_CONFIG_COUNT: '2'\n      GIT_CONFIG_KEY_0: core.autocrlf\n      GIT_CONFIG_VALUE_0: 'false'\n      GIT_CONFIG_KEY_1: core.longpaths\n      GIT_CONFIG_VALUE_1: 'true'\n    steps:\n      - name: Recover exact source from GitHub\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 2\n\n      - name: Setup current compiler and target runtime\n        uses: actions/setup-dotnet@v4\n        with:\n          dotnet-version: |\n            8.0.x\n            10.0.x\n\n      - name: Require reviewed first release, prepare and execute only worker2\n        shell: pwsh\n        run: |\n          $ErrorActionPreference = 'Stop'\n          $PSNativeCommandUseErrorActionPreference = $false\n          $releasePath = 'tests/selections/1536-hot-worker-windows.json'\n          $category = 'fr063-hot-worker-ready-disposition'\n          $evidence = 'TestResults/fr063-hot-worker-windows'\n          New-Item -ItemType Directory -Path $evidence -Force | Out-Null\n          function Require([bool]$Condition, [string]$Message) {\n            if (-not $Condition) { throw $Message }\n          }\n          function GitValue([string[]]$GitArgs) {\n            $value = & git @GitArgs\n            Require ($LASTEXITCODE -eq 0) \"Git read failed: $($GitArgs -join ' ')\"\n            return $value\n          }\n          function DllPins {\n            @('BookOfEternityClient.Tests/bin/Debug/net8.0/BookOfEternityClient.dll',\n              'BookOfEternityClient.Tests/bin/Debug/net8.0/BookOfEternityClient.Tests.dll',\n              'BookOfEternityClient.IntegrationTests/bin/Debug/net8.0/BookOfEternityClient.dll',\n              'BookOfEternityClient.IntegrationTests/bin/Debug/net8.0/BookOfEternityClient.IntegrationTests.dll') | ForEach-Object {\n              [ordered]@{ Path = $_; Bytes = (Get-Item -LiteralPath $_).Length; Sha256 = (Get-FileHash -LiteralPath $_ -Algorithm SHA256).Hash }\n            }\n          }\n          function OwnedPrefix {\n            @(Get-ChildItem -LiteralPath ([IO.Path]::GetTempPath()) -Force -Filter 'boe-gameengine-turnlifecycle-*' | Sort-Object FullName | ForEach-Object FullName)\n          }\n          function InvokeBounded([string]$Label, [string[]]$InvocationArgs) {\n            $prior = @(Get-ChildItem TestResults/test-categories -Directory -ErrorAction SilentlyContinue | ForEach-Object FullName)\n            $started = [DateTimeOffset]::UtcNow\n            & pwsh -NoLogo -NoProfile -File ./scripts/test-csharp.ps1 @InvocationArgs *>&1 | Tee-Object \"$evidence/$Label.stdout.log\" | Out-Host\n            $native = $LASTEXITCODE\n            $ended = [DateTimeOffset]::UtcNow\n            $new = @(Get-ChildItem TestResults/test-categories -Directory | Where-Object FullName -NotIn $prior)\n            $record = [ordered]@{ Label = $Label; Argv = @('pwsh', '-NoLogo', '-NoProfile', '-File', 'scripts/test-csharp.ps1') + $InvocationArgs; Source = $env:GITHUB_SHA; StartedUtc = $started.ToString('O'); EndedUtc = $ended.ToString('O'); NativeExit = $native; ResultDirectories = @($new.FullName) }\n            $record | ConvertTo-Json -Depth 12 | Set-Content \"$evidence/$Label.native.json\" -Encoding utf8NoBOM\n            Require ($new.Count -eq 1) \"Expected exactly one new result directory for $Label.\"\n            return [pscustomobject]@{ NativeExit = $native; Directory = $new[0].FullName }\n          }\n          Require ([OperatingSystem]::IsWindows()) 'Positive ordinary worker qualification requires native WindowsJob.'\n          Require ($env:GITHUB_EVENT_NAME -ceq 'push' -and $env:GITHUB_REF -ceq 'refs/heads/1536-wound-b2-cloud-20261012') 'Wrong release event or branch.'\n          Require ($env:GITHUB_RUN_ATTEMPT -ceq '1') 'No workflow/job retry is released.'\n          $head = GitValue @('rev-parse', 'HEAD')\n          Require ($head -ceq $env:GITHUB_SHA) 'Checkout differs from event SHA.'\n          Require (@(GitValue @('status', '--porcelain')).Count -eq 0) 'Checkout is not clean.'\n          $release = Get-Content -LiteralPath $releasePath -Raw | ConvertFrom-Json -AsHashtable\n          Require ($release.schemaVersion -eq 1 -and $release.decision -ceq 'ACCEPTED_SOURCE_FIRST_WINDOWS_WORKER2') 'No exact first-worker release.'\n          Require ($release.reviewedSource -cmatch '^[0-9a-f]{40}$' -and $release.acceptedCheckpoint -cmatch '^[0-9a-f]{40}$') 'Release source pins are invalid.'\n          Require ((GitValue @('rev-parse', 'HEAD^')) -ceq $release.acceptedCheckpoint) 'Release is not directly after the saved SOURCE acceptance.'\n          Require (@(GitValue @('ls-tree', '-r', '--name-only', $release.acceptedCheckpoint, '--', $releasePath)).Count -eq 0) 'Release file must be a first addition.'\n          $releaseDiff = @(GitValue @('diff', '--name-status', $release.acceptedCheckpoint, 'HEAD'))\n          Require ($releaseDiff.Count -eq 1 -and $releaseDiff[0] -ceq \"A`t$releasePath\") 'Release commit must add only the dedicated release file.'\n          # Explicit bounded pinned history