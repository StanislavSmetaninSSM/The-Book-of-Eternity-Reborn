::GetTempPath().TrimEnd([IO.Path]::DirectorySeparatorChar) -and [IO.Path]::GetFileName($root) -cmatch '^boe-gameengine-turnlifecycle-[0-9a-f]{32}$') 'Receipt root is outside the exact owned temp scope.'\n              $absent = $false\n              try { Get-Item -LiteralPath $root -Force -ErrorAction Stop | Out-Null }\n              catch [System.Management.Automation.ItemNotFoundException] { $absent = $true }\n              $physicalRecords += [ordered]@{ TestId = $result.testId; TestName = $result.testName; Receipt = $receipt; PhysicalRoot = $root; PhysicallyAbsentOnWindows = $absent }\n              Require ($receipt.OwnedFixtureRemoved -and $null -eq $receipt.CleanupFailure -and $absent) 'Strict owned Windows root cleanup did not complete.'\n            }\n            Require (@($physicalRecords.PhysicalRoot | Sort-Object -Unique).Count -eq 2) 'Worker roots are not distinct.'\n          }\n          catch { $physicalFailure = $_ }\n          [ordered]@{ Host = 'Windows'; TempPath = [IO.Path]::GetTempPath(); Records = $physicalRecords; Error = if ($physicalFailure) { $physicalFailure.ToString() } else { $null } } | ConvertTo-Json -Depth 12 | Set-Content \"$evidence/physical-cleanup.json\" -Encoding utf8NoBOM\n          if ($actualFailure) { throw $actualFailure }\n          if ($physicalFailure) { throw $physicalFailure }\n          Require ($afterHead -ceq $head -and $afterStatus.Count -eq 0 -and $afterTemp.Count -eq 0 -and (($beforeDll | ConvertTo-Json -Compress) -ceq ($afterDll | ConvertTo-Json -Compress))) 'Source, DLL or owned cleanup continuity failed.'\n          Require ($actualRun.NativeExit -eq 0) 'FIRST worker2 failed; preserve the original packet and stop, no retry.'\n          $summary = Get-Content (Join-Path $actualRun.Directory 'summary.json') -Raw | ConvertFrom-Json\n          Require ($summary.Revision.Head -ceq $head -and $summary.Revision.ChangedFiles -eq 0 -and $summary.ExitCode -eq 0 -and -not $summary.TimedOut -and $summary.OwnedTreeClean