Json\n          $planSummary = Get-Content (Join-Path $planRun.Directory 'summary.json') -Raw | ConvertFrom-Json\n          Require ($planSummary.PlanOnly -and $planSummary.Tests.Executed -eq 0 -and @($plan.Descriptors).Count -eq 1) 'PlanOnly must execute zero tests and plan one descriptor.'\n          $descriptor = $plan.Descriptors[0]\n          Require ($descriptor.Category -ceq $category -and $descriptor.Adapter -ceq 'integration' -and $descriptor.Exclusive -and -not $descriptor.FrontendBuild -and $descriptor.BudgetMinutes -eq 5 -and $descriptor.EstimatedCases -eq 2 -and @($descriptor.ExpectedMethodCounts).Count -eq 1 -and $descriptor.ExpectedMethodCounts[0].Name -ceq 'BookOfEternityClient.Tests.GameEngineTurnLifecycleTests.HotSubmission_ActualWorkerApplyCannotIssueOrdinaryReadyCustody' -and $descriptor.ExpectedMethodCounts[0].Cases -eq 2) 'Exact worker method/count/budget differs.'\n          $beforeDll = @(DllPins)\n          $beforeTemp = @(OwnedPrefix)\n          Require ($beforeTemp.Count -eq 0) 'Scoped fixture residue exists before actual.'\n          Require (@(GitValue @('status', '--porcelain')).Count -eq 0) 'Source changed during preparation.'\n          $beforeDll | ConvertTo-Json -Depth 8 | Set-Content \"$evidence/dll-before.json\" -Encoding utf8NoBOM\n          $beforeTemp | ConvertTo-Json -AsArray | Set-Content \"$evidence/temp-before.json\" -Encoding utf8NoBOM\n          $actualFailure = $null\n          try { $actualRun = InvokeBounded 'first-worker2' @('-SelectionFile', $releasePath, '-NoBuild') }\n          catch { $actualFailure = $_ }\n          finally {\n            $afterDll = @(DllPins)\n            $afterTemp = @(OwnedPrefix)\n            $afterStatus = @(GitValue @('status', '--porcelain'))\n            $afterHead = GitValue @('rev-parse', 'HEAD')\n            [ordered]@{ Source = $afterHead; Status = $afterStatus; Dll = $afterDll; ScopedTemp = $afterTemp; WrapperFailure = if ($actualFailure) { $actualFailure.ToString() } else { $null } } | ConvertTo-Json -Depth 12 | Set-Content \"$evidence/after-actual.json\" -Encoding utf8NoBOM\n          }\n          if ($actualFailure) { throw $actualFailure }\n          Require ($afterHead -ceq $head -and $afterStatus.Count -eq 0 -and $afterTemp.Count -eq 0 -and (($beforeDll | ConvertTo-Json -Compress) -ceq ($afterDll | ConvertTo-Json -Compress))) 'Source, DLL or owned cleanup continuity failed.'\n          Require ($actualRun.NativeExit -eq 0) 'FIRST worker2 failed; preserve the original packet and stop, no retry.'\n          $summary = Get-Content (Join-Path $actualRun.Directory 'summary.json') -Raw | ConvertFrom-Json\n          Require ($summary.ExitCode -eq 0 -and -not $summary.TimedOut -and $summary.OwnedTreeCleanupSucceeded -and $summary.RuntimeCleanupSucceeded -and $summary.Selection.PlannedDescriptors -eq 1 -and $summary.Selection.CompletedDescriptors -eq 1 -and $summary.Selection.PlannedCases -eq 2 -and $summary.Selection.CompletedCases -eq 2 -and $summary.Selection.Complete -and $summary.Tests.Total -eq 2 -and $summary.Tests.Executed -eq 2 -and $summary.Tests.Passed -eq 2 -and $summary.Tests.Failed -eq 0 -and @($summary.DuplicateTests).Count -eq 0 -and @($summary.CategoryResults).Count -eq 1 -and $summary.CategoryResults[0].Completed -and $summary.CategoryResults[0].BudgetMinutes -eq 5 -and $summary.CategoryResults[0].Seconds -le 300) 'Exact positive two-case/cleanup result did not qualify.'\n          Write-Host 'FIRST native Windows worker2 packet preserved; separate EVIDENCE and final bounded review remain required.'\n\n      - name: Preserve every native outcome and preparation artifact\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: fr063-hot-worker-windows-${{ github.sha }}-${{ github.run_attempt }}\n          path: |\n            TestResults/test-categories/\n            TestResults/fr063-hot-worker-windows/\n          if-no-files-found: warn\n          retention-days: 30\n",
