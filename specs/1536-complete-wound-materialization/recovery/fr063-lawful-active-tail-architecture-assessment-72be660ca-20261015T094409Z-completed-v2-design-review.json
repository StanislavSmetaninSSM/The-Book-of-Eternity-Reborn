    {
      "id": "STATS_LEVEL_NONATOMIC",
      "classification": "source-derived crash/replay risk, not executed",
      "evidence": [
        "BookOfEternityClient/Core/GameEngine/GameEngine.TurnLifecycle.cs:2447",
