+            !string.Equals(targetKind, "player", StringComparison.Ordinal))
+        {
+            playerSupporters.Add(target.DeepClone());
+        }
+        else if (string.Equals(side, "opposition", StringComparison.Ordinal))
+        {
+            oppositionLead = target.DeepClone().AsObject();
+        }
